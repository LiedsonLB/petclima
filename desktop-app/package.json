{
  "name": "PetSaudeClima",
  "version": "1.0.0",
  "description": "Aplicativo desktop do PET-Saúde Clima, portal de vigilância territorial em saúde e clima do Piauí.",
  "main": "main.js",
  "author": {
    "name": "LiedsonLB",
    "email": "SEU_EMAIL_AQUI@exemplo.com"
  },
  "homepage": "https://petsaudeclima.mooo.com",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.liedsonlb.petsaudeclima",
    "productName": "PET-Saúde Clima",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "picker.html",
      "picker-renderer.js",
      "picker-preload.js",
      "build/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/petsaudeclima.ico",
      "signtoolOptions": {
        "certificateFile": "777.pfx",
        "certificatePassword": ""
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/petsaudeclima_icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/petsaudeclima_icon.icns"
    }
  }
}